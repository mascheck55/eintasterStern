				(size 1.27 1.27)
			)
		)
		(uuid "96f3b664-08fb-43e2-9e89-b03140c5df3e")
	)
	(text "D1 ist ein 1A Typ der 0,7V Spannungsabfall erzeugt, unter Belastung von 0,5A etwa 1,3V. \nDamit stellt sich die Spannung an den Dioden je nach Typ auf 2,9 ... 3,7V ein."
		(exclude_from_sim no)
		(at 94.234 43.942 0)
		(effects
